              <div>Stato: <strong>${a.status}</strong></div>
              <div>Certificato: ${certBadge}</div>
              <div>Totale Versato: <strong
style=3D"color:var(--success-color)">=E2=82=AC${totalPaid.toFixed(2)}</stro=
ng></div>
              <div class=3D"actions">
                <button class=3D"btn btn-success" onclick=3D"openPayModal('=
${
a.id}')">=F0=9F=92=B6 Pagamento Rapido</button>
                <button class=3D"btn" onclick=3D"openAthleteModal('${a.id
}')">Modifica</button>
                <button class=3D"btn btn-danger" onclick=3D"deleteAthlete('=
${
a.id}')">Elimina</button>
              </div>
            </div>
          </div>
        `;
      });
    }

    function renderDashboard() {
      const container =3D document.getElementById('alerts-container');
      container.innerHTML =3D '';

      document.getElementById('total-athletes').innerText =3D athletes.leng=
th;

      // Calcolo Totale Mensile
      const now =3D new Date();
      const currentMonth =3D now.getMonth();
      const currentYear =3D now.getFullYear();

      let monthTotal =3D 0;
      athletes.forEach(a =3D> {
        (a.payments || []).forEach(p =3D> {
          const pDate =3D new Date(p.date);
          if(pDate.getMonth() =3D=3D=3D currentMonth && pDate.getFullYear()=
 =3D=3D=3D
currentYear) {
            monthTotal +=3D p.amount;
          }
        });
      });

      document.getElementById('month-revenue').innerText =3D
`=E2=82=AC${monthTotal.toFixed(2)}`;

      let alerts =3D 0;
      athletes.forEach(a =3D> {
        const certDays =3D getDaysDiff(a.certExpiry);
        if(certDays <=3D 30) {
          alerts++;
          const isExpired =3D certDays <=3D 0;
          container.innerHTML +=3D `
            <div style=3D"padding: 10px; border-radius:6px; margin-bottom:
8px; background: ${isExpired ? 'rgba(239, 68, 68, 0.2)' : 'rgba(245, 158,
11, 0.2)'}">
              =E2=9A=A0=EF=B8=8F <strong>${a.name}</strong>: Certificato Me=
dico ${isExpired
? 'SCADUTO' : 'in scadenza tra ' + certDays + ' giorni'}.
            </div>
          `;
        }
      });

      if(alerts =3D=3D=3D 0) {
        container.innerHTML =3D '<div style=3D"color: var(--success-color)"=
>=E2=9C=85
Nessun avviso o certificato in scadenza imminente!</div>';
      }
    }

    // Init
    const savedColor =3D localStorage.getItem('pirates_color');
    if(savedColor) changeColor(savedColor);
    renderDashboard();
    renderAthletes();
  </script>
</body>
</html>

